{
	"info": {
		"_postman_id": "lesson-studio-api-collection",
		"name": "Lesson Studio API",
		"description": "Postman Collection test toàn bộ Backend API cho dự án Lesson Studio / Adaptive Learning",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. GET Knowledge Graph",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://127.0.0.1:8000/adaptive/knowledge-graph/lesson_01",
					"protocol": "http",
					"host": ["127", "0", "0", "1"],
					"port": "8000",
					"path": ["adaptive", "knowledge-graph", "lesson_01"]
				}
			}
		},
		{
			"name": "2. GET Concepts by Slide (Slide 20)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://127.0.0.1:8000/adaptive/concepts/by-slide/20",
					"protocol": "http",
					"host": ["127", "0", "0", "1"],
					"port": "8000",
					"path": ["adaptive", "concepts", "by-slide", "20"]
				}
			}
		},
		{
			"name": "3. GET Concepts by Time (755s)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://127.0.0.1:8000/adaptive/concepts/by-time/755",
					"protocol": "http",
					"host": ["127", "0", "0", "1"],
					"port": "8000",
					"path": ["adaptive", "concepts", "by-time", "755"]
				}
			}
		},
		{
			"name": "4. POST Quiz Answer (Submit wrong answer for c6)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"quiz_id\": \"q6\",\n  \"concept_id\": \"c6\",\n  \"is_correct\": false,\n  \"difficulty\": 1.0\n}"
				},
				"url": {
					"raw": "http://127.0.0.1:8000/adaptive/quiz/answer?student_id=student_1",
					"protocol": "http",
					"host": ["127", "0", "0", "1"],
					"port": "8000",
					"path": ["adaptive", "quiz", "answer"],
					"query": [
						{
							"key": "student_id",
							"value": "student_1"
						}
					]
				}
			}
		},
		{
			"name": "5. GET Adaptive Recommendation",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://127.0.0.1:8000/adaptive/recommendation/student_1?current_concept_id=c6",
					"protocol": "http",
					"host": ["127", "0", "0", "1"],
					"port": "8000",
					"path": ["adaptive", "recommendation", "student_1"],
					"query": [
						{
							"key": "current_concept_id",
							"value": "c6"
						}
					]
				}
			}
		},
		{
			"name": "6. GET Student Mastery Summary",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://127.0.0.1:8000/adaptive/mastery/student_1",
					"protocol": "http",
					"host": ["127", "0", "0", "1"],
					"port": "8000",
					"path": ["adaptive", "mastery", "student_1"]
				}
			}
		}
	]
}
